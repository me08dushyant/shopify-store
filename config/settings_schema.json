[
  {
    "name": "theme_info",
    "theme_name": "Learning Theme",
    "theme_author": "Dushyant",
    "theme_version": "1.0.0",
    "theme_documentation_url": "https://github.com/",
    "theme_support_email": "me08dushyant@gmail.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Base"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_foreground",
        "label": "Foreground",
        "default": "#121212"
      },
      {
        "type": "header",
        "content": "Primary"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary",
        "default": "#121212"
      },
      {
        "type": "color",
        "id": "color_primary_foreground",
        "label": "Primary foreground",
        "default": "#ffffff"
      },
      {
        "type": "header",
        "content": "Secondary"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary",
        "default": "#f4f4f4"
      },
      {
        "type": "color",
        "id": "color_secondary_foreground",
        "label": "Secondary foreground",
        "default": "#121212"
      },
      {
        "type": "header",
        "content": "Accents & feedback"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#1a73e8"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border",
        "default": "#e5e5e5"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#6b6b6b"
      },
      {
        "type": "color",
        "id": "color_error",
        "label": "Error",
        "default": "#d82c0d"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "Success",
        "default": "#108043"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Headings"
      },
      {
        "type": "font_picker",
        "id": "font_heading_family",
        "label": "Font",
        "default": "sans-serif"
      },
      {
        "type": "range",
        "id": "font_heading_scale",
        "label": "Font size scale",
        "min": 80,
        "max": 150,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "header",
        "content": "Body"
      },
      {
        "type": "font_picker",
        "id": "font_body_family",
        "label": "Font",
        "default": "sans-serif"
      },
      {
        "type": "range",
        "id": "font_body_scale",
        "label": "Font size scale",
        "min": 80,
        "max": 150,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1200
      },
      {
        "type": "range",
        "id": "container_padding",
        "label": "Container padding",
        "min": 8,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 16
      }
    ]
  },
  {
    "name": "Buttons & inputs",
    "settings": [
      {
        "type": "range",
        "id": "border_radius",
        "label": "Corner radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 8
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Will be scaled down to 32 x 32px"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "header",
        "content": "Social accounts"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook",
        "info": "https://facebook.com/shopify"
      },
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "info": "http://instagram.com/shopify"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "X (Twitter)",
        "info": "http://x.com/shopify"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok",
        "info": "https://tiktok.com/@shopify"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube",
        "info": "https://youtube.com/shopify"
      }
    ]
  }
]
